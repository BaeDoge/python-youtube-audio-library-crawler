# ============================================================
# YouTube / Chrome
# ============================================================

CDP_URL=http://127.0.0.1:9222

CHANNEL_ID=UCzLBIavNT7yYjN1sl1cCnrg


# ============================================================
# Directory
# ============================================================

DOWNLOAD_DIR=output/downloads
PLAYLIST_DIR=output/playlists
DRAFT_DIR=output/playlist_drafts
USED_FILE=data/used.txt


# ============================================================
# Audio filtering
# ============================================================

# 30초짜리 음악 등을 후보에서 제외하기 위한 최소 길이
MIN_TRACK_DURATION_SECONDS=120

# 0이면 최대 길이 제한 없음
MAX_TRACK_DURATION_SECONDS=0

# 한 영상에 사용할 수 있는 최대 곡 수
MAX_TRACKS_PER_PLAYLIST=12

# scoring에서 선호하는 음악 길이
# 예: 240 = 4분
PREFERRED_TRACK_DURATION_SECONDS=240


# ============================================================
# Playlist scoring
# ============================================================

# 곡 자체의 적절한 길이에 대한 가중치
SCORING_DURATION_WEIGHT=10.0

# Mood가 비슷한 곡을 이어 붙이는 가중치
SCORING_MOOD_WEIGHT=5.0

# Genre가 비슷한 곡을 이어 붙이는 가중치
SCORING_GENRE_WEIGHT=3.0

# 동일 Artist가 반복될 경우 감점
SCORING_ARTIST_REPEAT_PENALTY=8.0

# 같은 점수의 조합에 약간의 랜덤성을 추가
SCORING_RANDOMNESS_WEIGHT=0.5


# 하나의 총 재생시간에 대해 유지할 후보 조합 수
BEAM_WIDTH_PER_DURATION=4


# ============================================================
# Playlist package
# ============================================================

# true:
#   output/playlists/xxx/tracks/ 에 개별 MP3를 복사
#
# false:
#   output/downloads/ 아래의 원본 MP3만 유지
COPY_TRACKS_TO_PLAYLIST=true


# ============================================================
# FFmpeg
# ============================================================

# PATH에 ffmpeg가 있다면 그대로 사용
FFMPEG_BIN=ffmpeg

# Windows에서 직접 경로를 지정하고 싶다면:
#
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe

SHORTS_SOURCE_DIR="C:\Users\배승호\AppData\Local\CapCut\Videos"

# Optional: Jamendo API client ID for external music catalog metadata.
# Register an application at https://devportal.jamendo.com/
# Check API terms before use on monetized/commercial channels.
JAMENDO_CLIENT_ID=
