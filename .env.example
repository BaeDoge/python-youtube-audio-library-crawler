# Copy to .env (or run `music-crawler init`). Never commit .env.

# --- sources -------------------------------------------------------------
# Jamendo: free client id from https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=
# Openverse: optional (anonymous works but is rate-limited); free keys raise the limit.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# YouTube Audio Library (optional, needs `pip install ".[youtube]"` + logged-in Chrome)
YOUTUBE_CHANNEL_ID=
CDP_URL=http://127.0.0.1:9222

# --- tools -----------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- selection defaults ----------------------------------------------------
MIN_TRACK_SECONDS=120
MAX_TRACK_SECONDS=0
PREFERRED_TRACK_SECONDS=240
MAX_PER_ARTIST=2

# --- output ------------------------------------------------------------------
CROSSFADE_SECONDS=3
NORMALIZE_LOUDNESS=true
MP3_BITRATE=192k
# also copy every song of a playlist into <playlist>/tracks/ (numbered like `remove N`)
COPY_TRACKS=true

# Licenses accepted for download. Keep attribution-required ones ("cc-by") only if you
# publish the generated credits. Add "cc-by-sa" etc. at your own risk.
ALLOWED_LICENSES=cc0,pdm,cc-by,yt-audio-library,pixabay,user
